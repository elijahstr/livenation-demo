{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "HarnessDiscovery",
      "Effect": "Allow",
      "Action": [
        "bedrock-agentcore:ListAgentRuntimes",
        "bedrock-agentcore:ListHarnessVersions",
        "bedrock-agentcore:ListHarnesses"
      ],
      "Resource": "*"
    },
    {
      "Sid": "CreateHarness",
      "Effect": "Allow",
      "Action": [
        "bedrock-agentcore:CreateAgentRuntime",
        "bedrock-agentcore:CreateHarness",
        "bedrock-agentcore:CreateMemory",
        "bedrock-agentcore:TagResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "HarnessLifecycle",
      "Effect": "Allow",
      "Action": [
        "bedrock-agentcore:DeleteAgentRuntime",
        "bedrock-agentcore:DeleteHarness",
        "bedrock-agentcore:DeleteMemory",
        "bedrock-agentcore:DeleteWorkloadIdentity",
        "bedrock-agentcore:GetAgentRuntime",
        "bedrock-agentcore:GetHarness",
        "bedrock-agentcore:GetMemory",
        "bedrock-agentcore:ListTagsForResource",
        "bedrock-agentcore:TagResource",
        "bedrock-agentcore:UntagResource",
        "bedrock-agentcore:UpdateAgentRuntime",
        "bedrock-agentcore:UpdateHarness",
        "bedrock-agentcore:UpdateMemory"
      ],
      "Resource": [
        "arn:aws:bedrock-agentcore:us-east-1:009073575420:harness/livenation_demo-*",
        "arn:aws:bedrock-agentcore:us-east-1:009073575420:memory/*",
        "arn:aws:bedrock-agentcore:us-east-1:009073575420:runtime/*",
        "arn:aws:bedrock-agentcore:us-east-1:009073575420:workload-identity-directory/default/workload-identity/harness_livenation_demo-*"
      ]
    },
    {
      "Sid": "InvokeHarness",
      "Effect": "Allow",
      "Action": [
        "bedrock-agentcore:InvokeAgentRuntime",
        "bedrock-agentcore:InvokeHarness"
      ],
      "Resource": "arn:aws:bedrock-agentcore:us-east-1:009073575420:harness/livenation_demo-*"
    },
    {
      "Sid": "ManageHarnessExecutionRole",
      "Effect": "Allow",
      "Action": [
        "iam:CreateRole",
        "iam:DeleteRole",
        "iam:DeleteRolePolicy",
        "iam:GetRole",
        "iam:GetRolePolicy",
        "iam:ListAttachedRolePolicies",
        "iam:ListInstanceProfilesForRole",
        "iam:ListRolePolicies",
        "iam:ListRoleTags",
        "iam:PutRolePolicy",
        "iam:TagRole",
        "iam:UntagRole",
        "iam:UpdateAssumeRolePolicy",
        "iam:UpdateRole"
      ],
      "Resource": "arn:aws:iam::009073575420:role/livenation-demo-harness"
    },
    {
      "Sid": "PassHarnessExecutionRole",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::009073575420:role/livenation-demo-harness",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "bedrock-agentcore.amazonaws.com"
        }
      }
    },
    {
      "Sid": "ManageHarnessLogRetention",
      "Effect": "Allow",
      "Action": [
        "logs:DeleteLogGroup",
        "logs:PutRetentionPolicy"
      ],
      "Resource": "arn:aws:logs:us-east-1:009073575420:log-group:/aws/bedrock-agentcore/runtimes/*"
    },
    {
      "Sid": "DiscoverHarnessLogGroups",
      "Effect": "Allow",
      "Action": "logs:DescribeLogGroups",
      "Resource": "*"
    }
  ]
}
