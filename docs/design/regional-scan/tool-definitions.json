{
  "title": "Regional scan proposed tool definitions",
  "status": "draft; not deployed",
  "catalog": {
    "server_operations": [
      {
        "name": "list_regional_accounts",
        "description": "Server-only roster enumeration, version persistence, batch dispatch, result validation, and coverage computation."
      }
    ]
  },
  "tools": [
    {
      "name": "get_account_evidence",
      "description": "Read bounded account evidence from approved scoped projections.",
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["account_id", "sections"],
        "properties": {
          "account_id": { "type": "string", "minLength": 1, "maxLength": 128 },
          "sections": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "uniqueItems": true,
            "items": { "enum": ["activity", "contract", "purchases", "benefits"] }
          }
        }
      },
      "response_schema_ref": "response-schemas.json#/tool_responses/get_account_evidence"
    },
    {
      "name": "find_options",
      "description": "Find scoped option candidates. It does not reserve inventory or confirm seller eligibility.",
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["account_id"],
        "properties": {
          "account_id": { "type": "string", "minLength": 1, "maxLength": 128 },
          "event_id": { "type": "string", "minLength": 1, "maxLength": 128 },
          "product_id": { "type": "string", "minLength": 1, "maxLength": 128 },
          "page_size": { "type": "integer", "minimum": 1, "maximum": 50 },
          "constraints": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "quantity": { "type": "integer", "minimum": 1, "maximum": 100 },
              "max_unit_price": { "type": "number", "minimum": 0 }
            }
          }
        }
      },
      "response_schema_ref": "response-schemas.json#/tool_responses/find_options"
    },
    {
      "name": "ask_analytics",
      "description": "Ask a bounded question through the approved Genie connection. The server supplies roster scope.",
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["question"],
        "properties": {
          "question": { "type": "string", "minLength": 1, "maxLength": 2000 }
        }
      },
      "response_schema_ref": "response-schemas.json#/tool_responses/ask_analytics"
    }
  ]
}
